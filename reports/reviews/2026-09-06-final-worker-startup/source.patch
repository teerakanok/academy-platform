-  if (!parsed.ok) return false
-  const jwk = exactRecord(parsed.value, ['crv', 'd', 'kty', 'x', 'y'])
-  return !!jwk
-    && jwk.kty === 'EC'
-    && jwk.crv === 'P-256'
-    && typeof jwk.x === 'string'
-    && COORDINATE.test(jwk.x)
-    && typeof jwk.y === 'string'
-    && COORDINATE.test(jwk.y)
-    && typeof jwk.d === 'string'
