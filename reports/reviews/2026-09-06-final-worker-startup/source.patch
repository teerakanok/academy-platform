-function isSortedUniqueStringList(
-  value: unknown,
-  pattern: RegExp,
-  maximum: number,
-): value is string[] {
-  return Array.isArray(value)
-    && value.length <= maximum
-    && value.every((entry, index) => (
-      typeof entry === 'string'
-      && pattern.test(entry)
-      && (index === 0 || value[index - 1] < entry)
-    ))
-}
