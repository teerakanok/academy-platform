{
  "$schema": "node_modules/wrangler/config-schema.json",
  // entry ของหน้าร้าน Academy; retention scheduler มี Worker/credential แยกต่างหาก
  "main": "worker.ts",
  "name": "cyberskills-academy",
  "minify": true,
  "compatibility_date": "2025-03-25",
  // Date predates the default; Identity runtime reads text/secret bindings through process.env.
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env", "global_fetch_strictly_public"],
  // ครอบ observed 480 ms outlier แต่ยังต่ำกว่า Paid default 30 s ถึง 60 เท่า
  "limits": { "cpu_ms": 500 },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "EDGE_RATE_LIMITER", "class_name": "EdgeRateLimiter" }]
  },
  "migrations": [{ "tag": "v1-edge-rate-limiter", "new_sqlite_classes": ["EdgeRateLimiter"] }],
  // Private lesson media only. Never place MP4/VTT/PDF files under ASSETS.
  "r2_buckets": [
    { "binding": "COURSE_MEDIA", "bucket_name": "cyberskills-academy-media" }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true
    },
    "traces": { "enabled": false }
  },
  "vars": {
    // preview: ยังไม่เปิดให้ค้นเจอ และยังไม่เปิดระบบบัญชี
    // (ไม่มี NEXT_PUBLIC_SUPABASE_* = หน้า sign-in จะบอกตรงๆ ว่ายังไม่เปิด
    //  แทนที่จะโชว์ฟอร์มที่กดแล้ว error)
    "NEXT_PUBLIC_SEARCH_INDEXING": "off"
  }
}
