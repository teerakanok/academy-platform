# CyberSkills Academy — local development env
# คัดลอกเป็น .env.local แล้วเติมค่าจริงจาก `npx supabase status` (local เท่านั้น)
#
# ⚠️ ห้ามชี้ prod (supabase.cyberskills.co.th) เด็ดขาด — app/tests ใช้ local Supabase เท่านั้น
# ⚠️ ตัวแปร server-only โดยเจตนา — ห้ามเติม NEXT_PUBLIC_ prefix (browser ห้ามคุย DB ตรง)

# Dedicated Academy PostgREST only. Never point this at shared Pool A
# (`supabase.cyberskills.co.th`): this API accepts only the Academy runtime role.
ACADEMY_DATA_API_URL=http://127.0.0.1:50600

# At least 32 random bytes. This signs 60-second credentials for academy_runtime;
# it is not the Pool A JWT secret or any Supabase service-role key.
ACADEMY_DATA_API_JWT_SECRET=

# Isolated daily retention scheduler. This is a different PostgREST endpoint
# and signing secret from the application runtime boundary. The scheduler is a
# separate Worker with no public application routes.
ACADEMY_RETENTION_API_URL=http://127.0.0.1:50601
ACADEMY_RETENTION_API_JWT_SECRET=

# Dedicated retention API integration tests run only when all three values are
# set. The target is hard-limited to http://127.0.0.1 and cannot use production.
TEST_ACADEMY_RETENTION_API_URL=http://127.0.0.1:3102
TEST_ACADEMY_RETENTION_API_JWT_SECRET=
TEST_ACADEMY_RETENTION_DATABASE_ID=
TEST_ALLOW_DESTRUCTIVE_RETENTION_API=0

# Legacy direct GoTrue OTP exists only to provision disposable local E2E
# fixtures. It requires this explicit switch plus a loopback public URL; never
# set it for a deployed Academy runtime.
# ACADEMY_LEGACY_DIRECT_OTP_LOCAL_FIXTURE=1

# ---- ใช้เฉพาะฝั่ง tests (ไม่ใช้ใน app runtime) ----
# Supabase local API/service role ยังจำเป็นสำหรับ test setup, RLS negative tests,
# และ E2E fixture เท่านั้น. Academy application code จะไม่อ่านตัวแปรคู่นี้.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# anon key สำหรับ negative RLS tests — จาก `npx supabase status`
TEST_SUPABASE_ANON_KEY=
# Postgres ตรงสำหรับ RLS hardening assertions (ค่า default ของ supabase local)
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# เพดาน attempt ต่อ (user, node) ใน 30 นาที — ไม่ตั้ง = 3 ตามแผน W0-0
# production ไม่ต้องตั้ง · มีไว้ให้ชุดเทสเดินเส้นทางซ้ำได้โดยไม่ต้องแตะสมุดนับโควตา
# ATTEMPT_MAX_PER_WINDOW=3

# Private lesson media grants. Use a random value of at least 32 bytes; production
# configures this as a Worker secret, never as a NEXT_PUBLIC variable.
MEDIA_SIGNING_SECRET=
# Optional local-only fixture adapter. Production must leave this unset and use
# the COURSE_MEDIA private bucket binding handled by worker.ts.
# MEDIA_LOCAL_ROOT=/absolute/path/to/academy-web/private-media
